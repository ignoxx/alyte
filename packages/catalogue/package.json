{
  "name": "@alyte/catalogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx scripts/catalogue-build.ts",
    "catalogue:build": "tsx scripts/catalogue-build.ts",
    "catalogue:sign": "tsx scripts/catalogue-sign.ts",
    "catalogue:verify": "tsx scripts/catalogue-verify.ts",
    "catalogue:freshness": "tsx scripts/catalogue-freshness.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run catalogue:freshness && tsx --test src/**/*.test.ts",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  }
}
